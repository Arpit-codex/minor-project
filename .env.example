# AI Provider: 'freellmapi', 'gemini', or 'mock'
AI_PROVIDER=freellmapi

# FreeLLMAPI Unified LLM Router (Local proxy at localhost:3001)
FREELLMAPI_KEY=your_freellmapi_key_here
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto

# Embeddings: 'freellmapi', 'gemini', or 'local'
EMBEDDING_PROVIDER=freellmapi
FREELLMAPI_EMBEDDING_MODEL=auto

# Optional Google Gemini Direct configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Retrieval Thresholds & Context Limits
SIMILARITY_THRESHOLD=0.35
MEMORY_RELEVANCE_THRESHOLD=0.30
MAX_RECENT_MESSAGES=8
MAX_RETRIEVED_MEMORIES=5
MAX_CONTEXT_TOKENS=3000
MEMORY_AUTO_STORE_CONFIDENCE=0.65
